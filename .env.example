# Copy to .env for local development. Never commit real credentials.
# Every value below is fictional; replace placeholders only in your local .env.

# PostgreSQL (docker compose)
POSTGRES_USER=aintegrator
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aintegrator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aintegrator:change-me@localhost:5432/aintegrator
# Least-privilege role used only by the MCP server (fictional local password).
MCP_DATABASE_URL=postgresql+asyncpg://aintegrator_mcp:aintegrator-mcp-secret@localhost:5432/aintegrator

# Simulated providers (phase 1)
FIBERNET_BASE_URL=http://localhost:8001
FIBERNET_CLIENT_ID=replace-me
FIBERNET_CLIENT_SECRET=replace-me
LEGACYTEL_BASE_URL=http://localhost:8002
LEGACYTEL_USERNAME=replace-me
LEGACYTEL_PASSWORD=replace-me
SKYLINK_BASE_URL=http://localhost:8003
SKYLINK_API_KEY=replace-me
SKYLINK_WEBHOOK_SECRET=replace-me
SKYLINK_WEBHOOK_URL=http://localhost:8000/webhooks/skylink
WEBHOOK_RECEIVER_BASE_URL=http://localhost:8000

# Resilience and safety limits (phases 1-5)
PROVIDER_TIMEOUT_S=2.0
PROVIDER_CONNECT_TIMEOUT_S=1.0
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_BREAKER_THRESHOLD=5
PROVIDER_BREAKER_RESET_S=5.0
PROVIDER_CONCURRENCY_LIMIT=10
ELIGIBILITY_ASYNC_WAIT_S=8.0
RECONCILE_AFTER_S=300
MAX_ORDER_VALUE_EUR=2000
MAX_PERIOD_VALUE_EUR=20000
WRITE_RATE_LIMIT_PER_MINUTE=30
WEBHOOK_TIMESTAMP_TOLERANCE_S=300

# Tool-boundary security (phase 4)
# standard | read-only
MCP_TOOL_PROFILE=standard
APPROVAL_TTL_S=300
AUDIT_ENABLED=true

# LLM and agent loop (phase 2+)
LLM_API_KEY=replace-me
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=2048
AGENT_MAX_STEPS=8
# Fictional pricing estimates used by eval cost reports.
COST_INPUT_PER_MILLION=3.0
COST_OUTPUT_PER_MILLION=15.0
# Optional: only for `python -m aintegrator_evals --judge llm`; normal evals are offline.
# EVAL_LLM_API_KEY=replace-me

# RAG (phase 6): offline hash is used by CI; local needs `uv sync --extra local`.
RAG_EMBEDDER=hash
RAG_MODEL=BAAI/bge-small-en-v1.5
# Override only for the pgvector ingestion/CLI or the service-backed RAG test.
# RAG_DSN=postgresql://aintegrator:aintegrator@localhost:5432/aintegrator
# RAG_TEST_DATABASE_URL=postgresql://aintegrator:aintegrator@localhost:5432/aintegrator

# Observability (phase 7): off by default; enable with `uv sync --all-packages --extra otlp`.
# The compose stack overrides the endpoint with http://otel-collector:4317 for containers.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=aintegrator
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Jaeger UI for the local collector: http://localhost:16686

# Cost report planning assumptions (not observed spend; all rates above are fictional).
COST_REPORT_DAILY_RUNS=100
COST_REPORT_DAYS=30

# AWS/Terraform demo (phase 7): placeholders only; never put real ARNs or credentials here.
TF_VAR_aws_region=us-east-1
TF_VAR_name_prefix=aintegrator-demo
TF_VAR_image_tag=demo
TF_VAR_llm_api_key_secret_arn=arn:aws:secretsmanager:us-east-1:000000000000:secret:aintegrator/llm-placeholder
TF_VAR_database_url_secret_arn=arn:aws:secretsmanager:us-east-1:000000000000:secret:aintegrator/db-placeholder
# TF_VAR_provider_secret_arns is a JSON map in the shell, e.g. a single fictional key:
# TF_VAR_provider_secret_arns={"FIBERNET_CLIENT_ID":"arn:aws:ssm:us-east-1:000000000000:parameter/aintegrator/fibernet-id"}
