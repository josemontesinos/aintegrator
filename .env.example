# Copy to .env for local development. Never commit real credentials.

# PostgreSQL (docker compose)
POSTGRES_USER=aintegrator
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aintegrator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aintegrator:change-me@localhost:5432/aintegrator

# LLM (phase 2+)
LLM_API_KEY=replace-me
LLM_MODEL=claude-sonnet-5-5

# Simulated providers (phase 1+)
FIBERNET_CLIENT_ID=replace-me
FIBERNET_CLIENT_SECRET=replace-me
LEGACYTEL_USERNAME=replace-me
LEGACYTEL_PASSWORD=replace-me
SKYLINK_API_KEY=replace-me
SKYLINK_WEBHOOK_SECRET=replace-me

# Safety limits and runtime (phases 4-5)
MAX_ORDER_VALUE_EUR=2000
ELIGIBILITY_ASYNC_WAIT_S=70
RECONCILE_AFTER_S=300

# Observability (phase 7)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
